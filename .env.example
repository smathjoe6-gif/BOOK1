GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_FOLDER_ID=
DONE_FOLDER_ID=
SPREADSHEET_ID=

POLL_INTERVAL_MINUTES=15
POST_STAGGER_MINUTES=15

TIKTOK_USE_SANDBOX=true
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
