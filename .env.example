GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GK_TERMINAL folder ID -- this script's own folder, separate from GK_JING
# (which belongs to the Make.com scenario for Instagram/Facebook/Pinterest).
DRIVE_FOLDER_ID=
DONE_FOLDER_ID=
# GK_JING's folder ID -- the Make.com scenario's folder. Set this so a video
# dropped into either folder automatically gets copied into the other one
# too, reaching all 5 platforms (YouTube, TikTok, Instagram, Facebook,
# Pinterest) no matter which folder it lands in. Leave blank to disable.
MIRROR_FOLDER_ID=
# GK_JING_DONE's folder ID -- the Make.com side's own done folder. Mirroring
# checks this too (alongside DONE_FOLDER_ID above) so a video that's already
# finished on one side and moved to done doesn't look "missing" to the
# other, still-pending side and get copied back and reposted a second time.
# Leave blank to disable this check (mirroring still works, just without
# the duplicate-repost protection).
MIRROR_DONE_FOLDER_ID=
# GK_JING's folder ID -- set this so the script also writes a missing
# caption row for GK_JING videos (the ones Make.com posts to
# Instagram/Facebook/Pinterest), not just its own GK_TERMINAL ones. This is
# independent of MIRROR_FOLDER_ID/mirroring -- works even with mirroring
# turned off. The script never downloads, moves, or posts these videos
# itself, it only reads filenames and writes spreadsheet rows. Leave blank
# to skip this and only caption GK_TERMINAL videos as before.
GK_JING_FOLDER_ID=
SPREADSHEET_ID=

# How often to check for new videos, in minutes. Only one video gets posted
# per check even if several are waiting, so this also sets the spacing
# between posts when multiple videos show up at once.
POLL_INTERVAL_MINUTES=15

TIKTOK_USE_SANDBOX=true
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: automatic video creation with xAI's Grok Imagine API. This costs
# real money per video (roughly $0.08/second at 720p) -- leave
# AUTO_GENERATE_VIDEOS as false unless you want it spending on its own.
# At the defaults below (1 video/day, 5 seconds) that's ~$0.40/day. At
# 3/day and 10 seconds it's roughly $2.40/day (~$72/month) -- see README.
# (OmniRoute's free "Veo AI Free" provider was tried instead, but it timed
# out after 10 minutes on a real video-generation test -- too unreliable for
# the automated script. omnirouteVideo.js is still in the repo if that
# provider becomes reliable enough to revisit later.)
XAI_API_KEY=
AUTO_GENERATE_VIDEOS=false
AUTO_GENERATE_DAILY_LIMIT=1
AUTO_GENERATE_DURATION_SECONDS=5
AUTO_GENERATE_ASPECT_RATIO=9:16
# Which hour(s) of the day (0-23, this Mac's local time) to generate at --
# only the first AUTO_GENERATE_DAILY_LIMIT of these are actually used, so
# with the default limit of 1, only the first hour listed here fires.
AUTO_GENERATE_HOURS=8,13,18

# Optional: OmniRoute (https://github.com/diegosouzapw/omniroute), a local AI
# gateway the script talks to for writing captions/replies/video concepts.
# Install with "npm install -g omniroute", run "omniroute", open the
# dashboard at http://localhost:20128, connect a free provider, then copy
# the key from Dashboard -> Endpoints here. Leave blank to just use the
# built-in template captions instead -- everything still works without it.
OMNIROUTE_API_KEY=
# Model id OmniRoute expects for its "Veo AI Free" video provider. Confirm
# the exact string via OmniRoute's Playground -> Copy cURL if the default
# ever stops working.
OMNIROUTE_VIDEO_MODEL=veo
