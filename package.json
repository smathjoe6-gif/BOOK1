  "scripts": {
    "buffer-channels": "node src/bufferChannels.js",
    "auth": "node src/googleAuth.js",
    "auth-history": "node src/googleAuth.js token-history.json",
    "canva-auth": "node src/canvaAuth.js",
    "pinterest-auth": "node src/pinterestAuth.js",
    "facebook-redo": "node src/facebookRedo.js",
    "organize-covers": "node src/organizeCoverPool.js",
